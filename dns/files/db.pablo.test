$TTL 86400
@       IN      SOA     dns.pablo.test. admin.pablo.test. (
                        1           ; serial
                        3600        ; refresh
                        1800        ; retry
                        604800      ; expire
                        86400 )     ; negative cache TTL

@       IN      NS      dns.pablo.test.

dns     IN      A       192.168.57.5
negocio IN      A       192.168.57.7

www     IN      CNAME   negocio
ftp     IN      CNAME   negocio